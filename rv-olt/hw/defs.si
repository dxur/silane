// Shared RISC-V encodings.

// Major opcodes (insn[6:0]).
const OPC_LOAD: u7 = 0b0000011;
const OPC_LOAD_FP: u7 = 0b0000111;
const OPC_MISC_MEM: u7 = 0b0001111;
const OPC_OP_IMM: u7 = 0b0010011;
const OPC_AUIPC: u7 = 0b0010111;
const OPC_OP_IMM_32: u7 = 0b0011011;
const OPC_STORE: u7 = 0b0100011;
const OPC_STORE_FP: u7 = 0b0100111;
const OPC_AMO: u7 = 0b0101111;
const OPC_OP: u7 = 0b0110011;
const OPC_LUI: u7 = 0b0110111;
const OPC_OP_32: u7 = 0b0111011;
const OPC_MADD: u7 = 0b1000011;
const OPC_MSUB: u7 = 0b1000111;
const OPC_NMSUB: u7 = 0b1001011;
const OPC_NMADD: u7 = 0b1001111;
const OPC_OP_FP: u7 = 0b1010011;
const OPC_BRANCH: u7 = 0b1100011;
const OPC_JALR: u7 = 0b1100111;
const OPC_JAL: u7 = 0b1101111;
const OPC_SYSTEM: u7 = 0b1110011;

// What an instruction does, as the core sequences it.
enum Cls: u5 {
    Illegal,
    Alu,      // integer register/immediate ops, LUI, AUIPC (result in rd)
    Jal,
    Jalr,
    Branch,
    Load,
    Store,
    Amo,      // LR, SC and AMOs
    MulDiv,
    Csr,
    Ecall,
    Ebreak,
    Mret,
    Sret,
    Wfi,
    Sfence,
    Fence,    // FENCE and FENCE.I: no caches yet, so no-ops
    FpLoad,
    FpStore,
    Fp,       // everything else in F and D
}

enum AluOp: u4 { Add, Sub, Sll, Slt, Sltu, Xor, Srl, Sra, Or, And }

// A decoded instruction.
module Uop -> (
    cls: Cls,
    alu: AluOp,
    word: u1,      // a 32-bit (*W) operation
    pc_a: u1,      // the ALU's first operand is the pc (AUIPC), or zero for LUI
    zero_a: u1,
    use_imm: u1,   // the ALU's second operand is `imm`
    imm: u64,
    rd: u5,
    rs1: u5,
    rs2: u5,
    f3: u3,
);
