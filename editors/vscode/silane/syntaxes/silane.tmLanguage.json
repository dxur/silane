{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Silane",
  "scopeName": "source.si",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#module_declaration" },
    { "include": "#enum_declaration" },
    { "include": "#const_declaration" },
    { "include": "#let_declaration" },
    { "include": "#register_assignment" },
    { "include": "#keywords" },
    { "include": "#domain_labels" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#calls" },
    { "include": "#paths" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.si",
          "match": "//.*$"
        },
        {
          "name": "comment.block.si",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "strings": {
      "comment": "Import paths and the Rust paths of extern modules",
      "name": "string.quoted.double.si",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.other.std.si",
          "match": "\\bstd:[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "module_declaration": {
      "comment": "`module Name`, `extern module Name`, `module Alias = Target::<...>`",
      "match": "\\b(?:(extern)\\s+)?(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.modifier.extern.si" },
        "2": { "name": "keyword.declaration.module.si" },
        "3": { "name": "entity.name.type.module.si" }
      }
    },
    "enum_declaration": {
      "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.enum.si" },
        "2": { "name": "entity.name.type.enum.si" }
      }
    },
    "const_declaration": {
      "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.const.si" },
        "2": { "name": "variable.other.constant.si" }
      }
    },
    "let_declaration": {
      "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.let.si" },
        "2": { "name": "variable.other.declaration.si" }
      }
    },
    "register_assignment": {
      "comment": "`target <= value` at the start of a statement (or after `=>` in a match arm) drives a register; elsewhere `<=` is a comparison",
      "match": "(?:^|(?<=[{;])|(?<==>))\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\s*(?:\\.\\s*[A-Za-z_][A-Za-z0-9_]*|\\[[^\\]]*\\]))*)\\s*(<=)",
      "captures": {
        "1": {
          "patterns": [
            { "include": "#literals" },
            { "include": "#operators" },
            { "include": "#punctuation" },
            { "match": "[A-Za-z_][A-Za-z0-9_]*", "name": "variable.other.register.si" }
          ]
        },
        "2": { "name": "keyword.operator.assignment.register.si" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.si",
          "match": "\\b(if|else|match|for|in)\\b"
        },
        {
          "name": "keyword.other.import.si",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.declaration.si",
          "match": "\\b(module|enum|const|let)\\b"
        },
        {
          "name": "storage.modifier.si",
          "match": "\\b(extern|reset)\\b"
        },
        {
          "name": "keyword.operator.cast.si",
          "match": "\\bas\\b"
        },
        {
          "name": "constant.language.boolean.si",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "The `_` match arm",
          "name": "keyword.other.wildcard.si",
          "match": "\\b_\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "u1, u8, u64 ...",
          "name": "support.type.primitive.si",
          "match": "\\bu[0-9]+\\b"
        },
        {
          "comment": "u<expr>",
          "name": "support.type.primitive.si",
          "match": "\\bu(?=\\s*<)"
        },
        {
          "comment": "PascalCase names: modules, bundles, enums",
          "name": "entity.name.type.si",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.si",
          "match": "\\b0x[0-9A-Fa-f_]+(u[0-9]+)?\\b",
          "captures": { "1": { "name": "storage.type.numeric.si" } }
        },
        {
          "name": "constant.numeric.binary.si",
          "match": "\\b0b[01_]+(u[0-9]+)?\\b",
          "captures": { "1": { "name": "storage.type.numeric.si" } }
        },
        {
          "name": "constant.numeric.octal.si",
          "match": "\\b0o[0-7_]+(u[0-9]+)?\\b",
          "captures": { "1": { "name": "storage.type.numeric.si" } }
        },
        {
          "name": "constant.numeric.decimal.si",
          "match": "\\b[0-9][0-9_]*(u[0-9]+)?\\b",
          "captures": { "1": { "name": "storage.type.numeric.si" } }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "Built-in functions",
          "name": "support.function.builtin.si",
          "match": "\\b(cat|rep|clog2|min|max)(?=\\s*\\()"
        },
        {
          "comment": "Built-in methods",
          "match": "(\\.)\\s*(rev|any|all|width|len)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.si" },
            "2": { "name": "support.function.method.si" }
          }
        },
        {
          "comment": "Instantiation: Name( or Name::<",
          "name": "entity.name.function.instance.si",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*(\\(|::\\s*<))"
        }
      ]
    },
    "paths": {
      "comment": "Enum::Variant",
      "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "entity.name.type.enum.si" },
        "2": { "name": "punctuation.separator.path.si" },
        "3": { "name": "variable.other.enummember.si" }
      }
    },
    "domain_labels": {
      "comment": "`@label` on an extern module port: its clock domain",
      "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.annotation.si" },
        "2": { "name": "entity.name.label.domain.si" }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.si",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.si",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.si",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.si",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.bitwise.shift.si",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.wire.si",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.si",
          "match": "<|>"
        },
        {
          "name": "keyword.operator.arithmetic.si",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.bitwise.si",
          "match": "[&|^!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.separator.path.si", "match": "::" },
        { "name": "punctuation.accessor.si", "match": "\\." },
        { "name": "punctuation.terminator.si", "match": ";" },
        { "name": "punctuation.separator.colon.si", "match": ":" },
        { "name": "punctuation.separator.comma.si", "match": "," }
      ]
    }
  }
}
