// Synchronous FIFO holding up to DEPTH entries of WIDTH bits.
// Pushing while full and popping while empty are ignored.
module Fifo<DEPTH = 4, WIDTH = 8>(push: u1, pop: u1, wdata: u<WIDTH>) -> (
    rdata: u<WIDTH>,
    full: u1,
    empty: u1,
    count: u<clog2(DEPTH + 1)>,
) {
    let PTR = max(1, clog2(DEPTH));

    let mem: [u<WIDTH>; DEPTH];
    let wr_ptr: u<PTR>;
    let rd_ptr: u<PTR>;

    empty = count == 0;
    full = count == DEPTH;
    let do_push = push & !full;
    let do_pop = pop & !empty;

    if do_push {
        mem[wr_ptr] <= wdata;
        wr_ptr <= if wr_ptr == DEPTH - 1 { 0 } else { wr_ptr + 1 };
    }
    if do_pop {
        rd_ptr <= if rd_ptr == DEPTH - 1 { 0 } else { rd_ptr + 1 };
    }
    // `count` is an output driven by a register.
    match cat(do_push, do_pop) {
        0b10 => count <= count + 1,
        0b01 => count <= count - 1,
        _ => {}
    }

    rdata = mem[rd_ptr];
}

module Fifo3x16 = Fifo::<DEPTH = 3, WIDTH = 16>;
