// A valid/ready stream, written from the producer's side: the producer drives
// `valid` and `data`, and reads `ready`.
module Stream<W = 8>(ready: u1) -> (valid: u1, data: u<W>);

// One-entry pipeline register for a stream (a "skid-less" register slice).
module StreamReg<W = 8>(enq: Stream<W>) -> (deq: Stream<W>) {
    let full: u1;
    let held: u<W>;

    enq.ready = !full | deq.ready;
    if enq.valid & enq.ready {
        held <= enq.data;
        full <= 1;
    } else if deq.ready {
        full <= 0;
    }

    deq.valid = full;
    deq.data = held;
}

// Two register slices in a row, connected as whole bundles.
module Pipe2(enq: Stream) -> (deq: Stream) {
    let a = StreamReg(enq);
    let b = StreamReg(a.deq);
    deq = b.deq;
}

// Adds one to every element passing through; bundles connected field by field.
module Incr(enq: Stream) -> (deq: Stream) {
    deq.valid = enq.valid;
    deq.data = enq.data + 1;
    enq.ready = deq.ready;
}
